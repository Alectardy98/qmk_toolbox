<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="QMK_Toolbox.Views.MainWindow"
 Width="960" Height="740" MinWidth="720" MinHeight="540"
 FontSize="14" Title="QMK Toolbox" Icon="/Resources/qmk.ico" DragDrop.AllowDrop="True">
 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="12">
  <Menu Grid.Row="0">
   <MenuItem Header="_File">
    <MenuItem Header="_Open firmware" Command="{Binding OpenFileCommand}"/>
    <MenuItem Header="Save log…" Click="SaveLog"/>
    <MenuItem Header="Clear log" Command="{Binding ClearLogCommand}"/>
    <MenuItem Header="_Quit" Command="{Binding CloseCommand}"/>
   </MenuItem>
   <MenuItem Header="_Tools">
    <MenuItem Header="Key tester" Click="ShowKeyTester"/>
    <MenuItem Header="Clear EEPROM (left half)" Command="{Binding ClearLeftEepromCommand}" IsEnabled="{Binding CanClearEeprom}"/>
    <MenuItem Header="Clear EEPROM (right half)" Command="{Binding ClearRightEepromCommand}" IsEnabled="{Binding CanClearEeprom}"/>
   </MenuItem>
   <MenuItem Header="_Help">
    <MenuItem Header="Check upstream releases" Click="OpenReleases"/>
    <MenuItem Header="About" Click="ShowAbout"/>
   </MenuItem>
  </Menu>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto,180" Margin="0,12">
   <Border Name="border" BorderBrush="Gray" BorderThickness="1" Padding="8">
    <TextBlock Name="HexFile" Text="{Binding HexFile}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </Border>
   <Button Grid.Column="1" Content="Open…" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" Margin="8,0"/>
   <ComboBox Grid.Column="2" ItemsSource="{Binding Mcus}" SelectedIndex="{Binding SelectedMcuIndex}" IsEnabled="{Binding CanOpenFile}" HorizontalAlignment="Stretch"/>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
   <CheckBox Content="Auto flash" IsChecked="{Binding IsAutoFlash}" IsEnabled="{Binding CanAutoFlash}"/>
   <Button Content="Flash" Command="{Binding FlashCommand}" IsEnabled="{Binding CanFlash}"/>
   <Button Content="Clear EEPROM" Command="{Binding ClearEEPromCommand}" IsEnabled="{Binding CanClearEeprom}"/>
   <Button Content="Reset" Command="{Binding ExitDfuCommand}" IsEnabled="{Binding CanReset}"/>
  </StackPanel>
  <TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
   TextWrapping="Wrap" FontFamily="monospace" Background="#1e1e1e" Foreground="#dddddd"
   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
   <CheckBox Content="HID console" IsChecked="{Binding ListenToHid}"/>
   <ComboBox ItemsSource="{Binding HidDevices}" SelectedItem="{Binding SelectedHidDevice}" MinWidth="180"/>
   <CheckBox Content="Show all USB devices" IsChecked="{Binding ShowAllDevices}"/>
  </StackPanel>
  <StackPanel Grid.Row="5" Spacing="6" Margin="0,8,0,0">
   <Grid ColumnDefinitions="Auto,*">
    <TextBlock Text="STM32 target" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding Stm32Targets}" SelectedItem="{Binding SelectedStm32Target}" IsEnabled="{Binding CanOpenFile}" HorizontalAlignment="Stretch"/>
   </Grid>
   <TextBlock Text="{Binding FirmwareStatus}" TextWrapping="Wrap" FontSize="12"/>
   <Grid ColumnDefinitions="*,Auto">
    <TextBox Text="{Binding UartPort}" Watermark="Optional ROM UART: /dev/ttyUSB0 (manual wiring and boot mode required)" IsEnabled="{Binding CanOpenFile}"/>
    <Button Grid.Column="1" Content="Flash STM32 UART" Command="{Binding FlashStm32UartCommand}" IsEnabled="{Binding CanFlashUart}" Margin="8,0,0,0"/>
   </Grid>
  </StackPanel>
 </Grid>
</Window>
